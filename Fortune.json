
{
  "name": "WheelOfFortune",
  "display_name": "Колесо Фортуны",
  "description": "Мини-игра: колесо из визуализаторов + алтарь (бочка). Точка появления колеса задаётся в WOF.init (wof_wheel), всё остальное (алтарь, кнопка, барьеры, табло) строится относительно неё. Положи предмет в бочку, сделай ставку на цвет (номер в чат), кликни ПКМ по кнопке-сущности взаимодействия. Совпал цвет — предмет умножается на количество сегментов этого цвета. До 20 цветов, настройка через #wof.",
  "handlers": [
    {
      "type": "event",
      "position": 0,
      "event": "world_start",
      "operations": [
        { "action": "call_function", "values": [
          { "name": "function_name", "value": { "type": "text", "text": "WOF.init", "parsing": "plain" } },
          { "name": "args", "value": { "type": "map", "values": {} } }
        ] }
      ]
    },
    {
      "type": "event",
      "position": 1,
      "event": "player_chat",
      "operations": [
        { "action": "if_variable_text_starts_with", "values": [
          { "name": "value", "value": { "type": "game_value", "game_value": "event_chat_message", "selection": "null" } },
          { "name": "compare", "value": { "type": "text", "text": "#wof", "parsing": "plain" } },
          { "name": "ignore_case", "value": { "type": "enum", "enum": "TRUE" } }
        ], "operations": [
          { "action": "game_cancel_event", "values": [] },
          { "action": "call_function", "values": [
            { "name": "function_name", "value": { "type": "text", "text": "WOF.config", "parsing": "plain" } },
            { "name": "args", "value": { "type": "map", "values": {} } }
          ] }
        ] },
        { "action": "else", "values": [], "operations": [
          { "action": "set_variable_convert_text_to_number", "values": [
            { "name": "variable", "value": { "type": "variable", "variable": "betNum", "scope": "line" } },
            { "name": "text", "value": { "type": "game_value", "game_value": "event_chat_message", "selection": "null" } },
            { "name": "radix", "value": { "type": "number", "number": 10 } }
          ] },
          { "action": "if_variable_greater", "values": [
            { "name": "value", "value": { "type": "variable", "variable": "betNum", "scope": "line" } },
            { "name": "compare", "value": { "type": "number", "number": 0 } }
          ], "operations": [
            { "action": "if_variable_less_or_equals", "values": [
              { "name": "value", "value": { "type": "variable", "variable": "betNum", "scope": "line" } },
              { "name": "compare", "value": { "type": "number", "number": "%math(%length(wof_colors))" } }
            ], "operations": [
              { "action": "set_variable_value", "values": [
                { "name": "variable", "value": { "type": "variable", "variable": "%player%_bet", "scope": "save" } },
                { "name": "value", "value": { "type": "variable", "variable": "betNum", "scope": "line" } }
              ] },
              { "action": "select_player_by_name", "values": [
                { "name": "name_or_uuid", "value": { "type": "text", "text": "%player%", "parsing": "plain" } }
              ] },
              { "action": "player_send_message", "values": [
                { "name": "messages", "value": { "type": "text", "text": "&aСтавка принята: цвет №%math(betNum). Положи предмет в бочку алтаря и кликни ПКМ по кнопке.", "parsing": "legacy" } },
                { "name": "merging", "value": { "type": "enum", "enum": "SPACES" } }
              ] }
            ] }
          ] }
        ] }
      ]
    },
    {
      "type": "event",
      "position": 2,
      "event": "player_right_click_entity",
      "operations": [
        { "action": "select_reset", "values": [] },
        { "action": "select_add_event_target", "values": [
          { "name": "selection_type", "value": { "type": "enum", "enum": "VICTIM" } }
        ] },
        { "action": "if_entity_name_equals", "values": [
          { "name": "names_or_uuids", "value": { "type": "text", "text": "wof_button", "parsing": "plain" } }
        ], "operations": [
          { "action": "game_cancel_event", "values": [] },
          { "action": "call_function", "values": [
            { "name": "function_name", "value": { "type": "text", "text": "WOF.spin", "parsing": "plain" } },
            { "name": "args", "value": { "type": "map", "values": {} } }
          ] }
        ] }
      ]
    },
    {
      "type": "function",
      "position": 3,
      "name": "WOF.init",
      "values": [
        { "name": "parameters", "value": { "type": "array", "values": [] } },
        { "name": "is_hidden", "value": { "type": "enum", "enum": "TRUE" } },
        { "name": "icon", "value": { "type": "item", "item": "{Count:1b,id:\\\"minecraft:barrel\\\"}" } }
      ],
      "operations": [
        { "action": "set_variable_value", "values": [
          { "name": "variable", "value": { "type": "variable", "variable": "wof_wheel", "scope": "game" } },
          { "name": "value", "value": { "type": "location", "x": 0, "y": 80, "z": 0, "yaw": 0, "pitch": 0 } }
        ] },
        { "action": "set_variable_get_all_coordinates", "values": [
          { "name": "location", "value": { "type": "variable", "variable": "wof_wheel", "scope": "game" } },
          { "name": "x", "value": { "type": "variable", "variable": "cx", "scope": "game" } },
          { "name": "y", "value": { "type": "variable", "variable": "cy", "scope": "game" } },
          { "name": "z", "value": { "type": "variable", "variable": "cz", "scope": "game" } },
          { "name": "yaw", "value": { "type": "variable", "variable": "cyaw", "scope": "game" } },
          { "name": "pitch", "value": { "type": "variable", "variable": "cpitch", "scope": "game" } }
        ] },
        { "action": "set_variable_set_all_coordinates", "values": [
          { "name": "variable", "value": { "type": "variable", "variable": "altar", "scope": "game" } },
          { "name": "x", "value": { "type": "number", "number": "%math(cx)" } },
          { "name": "y", "value": { "type": "number", "number": "%math(cy - 3)" } },
          { "name": "z", "value": { "type": "number", "number": "%math(cz + 4)" } },
          { "name": "yaw", "value": { "type": "number", "number": 0 } },
          { "name": "pitch", "value": { "type": "number", "number": 0 } }
        ] },
        { "action": "set_variable_get_all_coordinates", "values": [
          { "name": "location", "value": { "type": "variable", "variable": "altar", "scope": "game" } },
          { "name": "x", "value": { "type": "variable", "variable": "ax", "scope": "game" } },
          { "name": "y", "value": { "type": "variable", "variable": "ay", "scope": "game" } },
          { "name": "z", "value": { "type": "variable", "variable": "az", "scope": "game" } },
          { "name": "yaw", "value": { "type": "variable", "variable": "ayaw", "scope": "game" } },
          { "name": "pitch", "value": { "type": "variable", "variable": "apitch", "scope": "game" } }
        ] },
        { "action": "if_variable_equals", "values": [
          { "name": "value", "value": { "type": "number", "number": "%math(%length(wof_colors))" } },
          { "name": "compare", "value": { "type": "number", "number": 0 } },
          { "name": "compare_type", "value": { "type": "enum", "enum": "ANY" } }
        ], "operations": [
          { "action": "set_variable_value", "values": [
            { "name": "variable", "value": { "type": "variable", "variable": "wof_colors", "scope": "game" } },
            { "name": "value", "value": { "type": "array", "values": [
              { "type": "text", "text": "minecraft:red_concrete", "parsing": "plain" },
              { "type": "text", "text": "minecraft:orange_concrete", "parsing": "plain" },
              { "type": "text", "text": "minecraft:yellow_concrete", "parsing": "plain" },
              { "type": "text", "text": "minecraft:lime_concrete", "parsing": "plain" },
              { "type": "text", "text": "minecraft:blue_concrete", "parsing": "plain" },
              { "type": "text", "text": "minecraft:purple_concrete", "parsing": "plain" },
              { "type": "text", "text": "minecraft:magenta_concrete", "parsing": "plain" },
              { "type": "text", "text": "minecraft:white_concrete", "parsing": "plain" }
            ] } }
          ] }
        ] },
        { "action": "set_variable_value", "values": [
          { "name": "variable", "value": { "type": "variable", "variable": "wof_angle", "scope": "game" } },
          { "name": "value", "value": { "type": "number", "number": 0 } }
        ] },
        { "action": "set_variable_value", "values": [
          { "name": "variable", "value": { "type": "variable", "variable": "wof_spinning", "scope": "game" } },
          { "name": "value", "value": { "type": "number", "number": 0 } }
        ] },
        { "action": "call_function", "values": [
          { "name": "function_name", "value": { "type": "text", "text": "WOF.buildWheel", "parsing": "plain" } },
          { "name": "args", "value": { "type": "map", "values": {} } }
        ] },
        { "action": "call_function", "values": [
          { "name": "function_name", "value": { "type": "text", "text": "WOF.rebuild", "parsing": "plain" } },
          { "name": "args", "value": { "type": "map", "values": {} } }
        ] },
        { "action": "call_function", "values": [
          { "name": "function_name", "value": { "type": "text", "text": "WOF.updateInfo", "parsing": "plain" } },
          { "name": "args", "value": { "type": "map", "values": {} } }
        ] },
        { "action": "call_function", "values": [
          { "name": "function_name", "value": { "type": "text", "text": "WOF.placeAll", "parsing": "plain" } },
          { "name": "args", "value": { "type": "map", "values": {} } }
        ] }
      ]
    },
