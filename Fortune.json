          { "name": "merging_mode", "value": { "type": "enum", "enum": "SPACES" } },
          { "name": "displayed_text", "value": { "type": "text", "text": "&f&l▼", "parsing": "legacy" } }
        ] },
        { "action": "game_spawn_text_display", "values": [
