          { "name": "custom_name", "value": { "type": "text", "text": "wof_info", "parsing": "plain" } },
          { "name": "merging_mode", "value": { "type": "enum", "enum": "SEPARATE_LINES" } },
          { "name": "displayed_text", "value": { "type": "text", "text": "&b&lКОЛЕСО ФОРТУНЫ", "parsing": "legacy" } }
        ] },
        { "action": "game_spawn_interaction_entity", "values": [
