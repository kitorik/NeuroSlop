{
  "handlers": [
    {
      "type": "event",
      "position": 0.0,
      "event": "player_join",
      "operations": [
        {
          "action": "set_variable_create_map",
          "values": [
            {"name": "variable", "value": {"type": "variable", "variable": "block_weights", "scope": "game"}},
            {"name": "keys", "value": {"type": "array", "values": [
              {"type": "text", "text": "minecraft:stone"},
              {"type": "text", "text": "minecraft:iron_block"},
              {"type": "text", "text": "minecraft:gold_block"},
              {"type": "text", "text": "minecraft:diamond_block"},
              {"type": "text", "text": "minecraft:wool"},
              {"type": "text", "text": "minecraft:feather"},
              {"type": "text", "text": "minecraft:sand"},
              {"type": "text", "text": "minecraft:anvil"}
            ]}},
            {"name": "values", "value": {"type": "array", "values": [
              {"type": "number", "number": 2.0},
              {"type": "number", "number": 4.0},
              {"type": "number", "number": 5.0},
              {"type": "number", "number": 6.0},
              {"type": "number", "number": 0.5},
              {"type": "number", "number": 0.1},
              {"type": "number", "number": 1.5},
              {"type": "number", "number": 8.0}
            ]}}
          ]
        }
      ]
    },
    {
      "type": "event",
      "position": 1.0,
      "event": "block_fall",
      "operations": [
        {
          "action": "set_variable_get_block_material",
          "values": [
            {"name": "variable", "value": {"type": "variable", "variable": "block_type", "scope": "local"}},
            {"name": "location", "value": {"type": "game_value", "game_value": "event_block_location"}}
          ]
        },
        {
          "action": "set_variable_get_map_value",
          "values": [
            {"name": "variable", "value": {"type": "variable", "variable": "weight", "scope": "local"}},
            {"name": "map", "value": {"type": "variable", "variable": "block_weights", "scope": "game"}},
            {"name": "key", "value": {"type": "variable", "variable": "block_type", "scope": "local"}},
            {"name": "default_value", "value": {"type": "number", "number": 1.0}}
          ]
        },
        {
          "action": "set_variable_value",
          "values": [
            {"name": "variable", "value": {"type": "variable", "variable": "gravity_multiplier", "scope": "local"}},
            {"name": "value", "value": {"type": "math", "math": "clamp(%var_local(weight), 0.1, 10)"}}
          ]
        },
        {
          "action": "select_entity_by_location",
          "values": [
            {"name": "location", "value": {"type": "game_value", "game_value": "event_block_location"}}
          ]
        },
        {
          "action": "entity_set_custom_tag",
          "values": [
            {"name": "name", "value": {"type": "text", "text": "falling_weight"}},
            {"name": "value", "value": {"type": "variable", "variable": "weight", "scope": "local"}}
          ]
        },
        {
          "action": "entity_give_potion_effect",
          "values": [
            {"name": "potions", "value": {"type": "array", "values": [
              {"type": "potion", "potion": "levitation", "amplifier": "%math(%var_local(gravity_multiplier) - 1)", "duration": 10}
            ]}},
            {"name": "show_icon", "value": {"type": "enum", "enum": "FALSE"}},
            {"name": "overwrite", "value": {"type": "enum", "enum": "TRUE"}}
          ]
        }
      ]
    },
    {
      "type": "event",
      "position": 2.0,
      "event": "entity_land",
      "operations": [
        {
          "action": "select_entity_by_conditional",
          "values": [
            {"name": "tag", "value": {"type": "text", "text": "falling_weight"}}
          ],
          "conditional": {"action": "if_entity_has_custom_tag", "is_inverted": false}
        },
        {
          "action": "entity_remove_custom_tag",
          "values": [
            {"name": "name", "value": {"type": "text", "text": "falling_weight"}}
          ]
        },
        {
          "action": "entity_remove_potion_effect",
          "values": [
            {"name": "potions", "value": {"type": "array", "values": [
              {"type": "potion", "potion": "levitation"}
            ]}}
          ]
        }
      ]
    }
  ]
}
